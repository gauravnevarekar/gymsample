rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the signed in user is the owner of this gym/user ID
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    
    // Check if the user has the super_admin custom claim
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.role == "super_admin";
    }

    // Isolate users collection
    match /users/{uid} {
      allow read, write: if isOwner(uid) || isSuperAdmin();
    }
    
    // Isolate gyms collection
    match /gyms/{gymId} {
      // Allows reading/writing the gym document itself
      allow read, write: if isOwner(gymId) || isSuperAdmin();
      
      // Subcollection isolation
      match /members/{memberId} {
        allow read, write: if isOwner(gymId) || isSuperAdmin();
      }
      match /payments/{paymentId} {
        allow read, write: if isOwner(gymId) || isSuperAdmin();
      }
      match /expenses/{expenseId} {
        allow read, write: if isOwner(gymId) || isSuperAdmin();
      }
    }
  }
}
