rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the signed in user is the owner of this gym/user ID
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Isolate users collection
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }
    
    // Isolate gyms collection
    match /gyms/{gymId} {
      // Allows reading/writing the gym document itself
      allow read, write: if isOwner(gymId);
      
      // Subcollection isolation: only the owner can manage these
      match /members/{memberId} {
        allow read, write: if isOwner(gymId);
      }
      match /payments/{paymentId} {
        allow read, create: if isOwner(gymId);
      }
      match /expenses/{expenseId} {
        allow read, write: if isOwner(gymId);
      }
    }
  }
}
